local function collectPackage(child)
    if child.ClassName ~= "Model" then return end
    local toolName = child:GetAttribute("ToolName")
    if not toolName then
        for _, c in ipairs(child:GetChildren()) do
            local t = c:GetAttribute("ToolName")
            if t then toolName = t break end
        end
    end
    if toolName ~= "SmallPackage" then return end
    local ok, cf = pcall(function() return child:GetBoundingBox() end)
    if ok and (currentStationPos - cf.Position).Magnitude > 200 then return end
    local handle = child:FindFirstChild("Handle")
    if not handle then return end
    local proxy = handle:FindFirstChild("proxy") or handle:FindFirstChildWhichIsA("ProximityPrompt")
    if not proxy then return end
    proxy.HoldDuration = 0
    handle.CFrame = hrp.CFrame
    task.wait(0.05)
    fireproximityprompt(proxy)
end

STATE.connect(ignore.ChildAdded, function(child)
    task.wait(0.1)
    task.spawn(collectPackage, child)
end)

