local giveActive      = false
local giveTargetName  = ""

local function findPlayer(partial)
    if not partial or partial == "" then return nil end
    local lower = partial:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Name:lower():find(lower, 1, true) then return p end
    end
end

local function givePackagesToPlayer(target)
    if not addToToolbarByte then warn("[Give] Byte fehlt") return end
    local ids = {}
    for id, item in pairs(ClientShared.LocalPlayer.Backpack) do
        if item.ItemId == "SmallPackage" then table.insert(ids, id) end
    end
    print("[Give] Sende", #ids, "Packages an", target.Name)

    local gave = 0
    for _, id in ipairs(ids) do
        if not giveActive then break end
        local known = {}
        for _, v in ipairs(lp.Backpack:GetChildren()) do known[v] = true end

        dataRemote:FireServer({{ KevArgs = { id, 1 } }, addToToolbarByte})
        task.wait(0.1)

        local tool, deadline = nil, tick() + 4
        repeat
            task.wait(0.05)
            for _, v in ipairs(lp.Backpack:GetChildren()) do
                if v:IsA("Tool") and not known[v] then tool = v break end
            end
        until tool or tick() > deadline

        if not tool then continue end
        humanoid:EquipTool(tool)
        task.wait(0.15)

        local giveEvt = tool:FindFirstChild("GivePackageRemoteEvent")
        if giveEvt and target.Character then
            giveEvt:FireServer(target.Character)
            gave += 1
            print("[Give]", gave, "/", #ids)
        end
        task.wait(0.3)
    end
    print("[Give] Fertig!", gave, "gegeben")
end

