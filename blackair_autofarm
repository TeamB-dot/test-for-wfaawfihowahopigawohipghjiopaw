-- Open Packages
-- ============================================================
local function openAllPackages()
    if not addToToolbarByte then
        warn("[Open] Byte nicht gefunden"); return 0
    end
    local ids = {}
    for id, item in pairs(ClientShared.LocalPlayer.Backpack) do
        if item.ItemId == "SmallPackage" then table.insert(ids, id) end
    end
    print("[Open] Ã–ffne", #ids, "Packages...")

    local opened = 0
    for _, id in ipairs(ids) do
        local known = {}
        for _, v in ipairs(lp.Backpack:GetChildren()) do known[v] = true end

        dataRemote:FireServer({{ KevArgs = { id, 1 } }, addToToolbarByte})
        task.wait(0.1)

        local tool, deadline = nil, tick() + 4
        repeat
            task.wait(0.05)
            for _, v in ipairs(lp.Backpack:GetChildren()) do
                if v:IsA("Tool") and not known[v] then tool = v break end
            end
        until tool or tick() > deadline

        if not tool then warn("[Open] Kein Tool fÃ¼r", id) continue end
        local openEvt = tool:FindFirstChild("OnOpenRemoteEvent")
        if not openEvt then continue end

        humanoid:EquipTool(tool)
        task.wait(0.2)
        openEvt:FireServer()
        opened += 1
        print("[Open]", opened, "/", #ids)
        task.wait(0.4)
    end
    print("[Open] Fertig!", opened, "geÃ¶ffnet")
    return opened
end

-- ============================================================
-- Server Hop (grÃ¶ÃŸter Server, letzte 5 skippen)
-- ============================================================
local PlaceID = game.PlaceId

local function serverHop()
    print("[Hop] Suche Server...")
    state.farmActive = true
    saveJSON(SAVE_FILE, state)

    local function tryHop(cursor)
        local url = "https://games.roblox.com/v1/games/" .. PlaceID
            .. "/servers/Public?sortOrder=Desc&limit=100"
        if cursor and cursor ~= "" then url = url .. "&cursor=" .. cursor end

        local ok, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        if not ok or not result or not result.data then
            task.wait(5); return tryHop("")
        end

        -- Kandidaten sammeln: nicht voll, nicht in letzten 5
        local candidates = {}
        for _, server in ipairs(result.data) do
            local id = tostring(server.id)
            if server.playing < server.maxPlayers then
                local skip = false
                for _, v in ipairs(lastServers) do
                    if v == id then skip = true break end
                end
                if not skip then
                    table.insert(candidates, { id = id, playing = server.playing })
                end
            end
        end

        -- GrÃ¶ÃŸten Server wÃ¤hlen
        table.sort(candidates, function(a, b) return a.playing > b.playing end)

        if #candidates > 0 then
            local target = candidates[1]
            table.insert(lastServers, target.id)
            if #lastServers > 5 then table.remove(lastServers, 1) end
            saveJSON(HOP_FILE, lastServers)
            print("[Hop] Springe auf Server mit", target.playing, "Spielern")
            pcall(TeleportService.TeleportToPlaceInstance, TeleportService, PlaceID, target.id, lp)
            task.wait(8)
        end

        local next = result.nextPageCursor
        if next and next ~= "" then return tryHop(next) end

        print("[Hop] Alle Server besucht, liste leeren...")
        lastServers = {}
        saveJSON(HOP_FILE, lastServers)
        task.wait(3)
        tryHop("")
    end

    tryHop("")
end

