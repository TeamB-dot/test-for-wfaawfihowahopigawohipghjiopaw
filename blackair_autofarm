local function loadJSON(file, default)
    local ok, raw = pcall(readfile, file)
    if ok and raw and raw ~= "" then
        local ok2, t = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok2 and type(t) == "table" then return t end
    end
    return default
end
local function saveJSON(file, t)
    pcall(writefile, file, HttpService:JSONEncode(t))
end

