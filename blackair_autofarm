local function equipBohrer()
    local tool = char:FindFirstChild(DRILL_ID) or lp.Backpack:FindFirstChild(DRILL_ID)
    if not tool then return false end
    if not char:FindFirstChild(DRILL_ID) then
        humanoid:EquipTool(tool)
        task.wait(0.5)
    end
    return true
end

local function findNearestPS()
    local closest, closestDist
    local ok, folder = pcall(function()
        return workspace.NEUE_MAP_STUCTURE.Props.Props.PackstationProps.Packstation
    end)
    if not ok or not folder then return nil, math.huge end
    for _, ps in ipairs(folder:GetChildren()) do
        local ok2, cf = pcall(function() return ps:GetModelCFrame() end)
        if ok2 then
            local d = (hrp.Position - cf.Position).Magnitude
            if not closestDist or d < closestDist then closestDist = d; closest = ps end
        end
    end
    return closest, closestDist or math.huge
end

local function openAllDoors(psModel)
    local tool = char:FindFirstChild(DRILL_ID)
    if not tool then return end
    local event = tool:FindFirstChild("OnBohrerTriggered")
    if not event then return end
    for _, door in ipairs(psModel:GetChildren()) do
        if not farmActive then break end
        if door.Name ~= "Door" or door:GetAttribute("IsOpen") then continue end
        for _ = 1, 3 do
            if door:GetAttribute("IsOpen") or not farmActive then break end
            event:FireServer(door)
            task.wait(1)
        end
    end
end

