-- Farm Loop (1x durchlauf â†’ Safe TP â†’ Server Hop)
-- ============================================================
task.spawn(function()
    while STATE.alive() do
        if not farmActive then task.wait(0.5) continue end

        for i, stationCF in ipairs(STATIONS) do
            if not farmActive or not STATE.alive() then break end
            print(string.format("[Farm] Station %d / %d", i, #STATIONS))

            local tpPos = getStationTP(stationCF)
            currentStationPos = stationCF.Position
            -- Platform direkt auf Station-Y, Spieler 1 Stud drÃ¼ber
            platform.CFrame = CFrame.new(tpPos.X, tpPos.Y - 0.25, tpPos.Z)
            hrp.CFrame = CFrame.new(tpPos.X, tpPos.Y + 1, tpPos.Z)
            task.wait(0.5)

            if not equipBohrer() then task.wait(1) continue end
            local psModel, dist = findNearestPS()
            if not psModel or dist > 120 then task.wait(1) continue end

            openAllDoors(psModel)
            task.wait(2)
        end

        if farmActive then
            farmActive = false
            print("[Farm] Alle Stationen done â†’ Safe TP â†’ Server Hop")
            hrp.CFrame = CFrame.new(SAFE_POS)
            task.wait(1.5)
            serverHop()
        end
    end
end)

