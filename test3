			TextSize    = 13,
			TextColor3  = T.TextDark,
			Position    = UDim2.new(0, TextX, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Size        = UDim2.new(1, -TextX - 10, 0, 16),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate   = Enum.TextTruncate.AtEnd,
		})

		-- ── Seite ─────────────────────────────────────────────────────
		local Page = New("ScrollingFrame", {
			Parent  = Content,
			Visible = false,
			BackgroundTransparency = 1,
			Size                 = UDim2.fromScale(1, 1),
			BorderSizePixel      = 0,
			CanvasSize           = UDim2.new(),
			AutomaticCanvasSize  = Enum.AutomaticSize.Y,
			ScrollingDirection   = Enum.ScrollingDirection.Y,
			ScrollBarThickness   = 3,
			ScrollBarImageColor3 = T.Stroke,
		}, {
			Padding(14, 14, 14, 14),
			New("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }),
		})

		table.insert(TabHolders, { Button = TabButton, Page = Page, Marker = Marker, Lbl = TabLabel, Icon = TabIcon })

		local function Select()
			for _, Entry in ipairs(TabHolders) do
				local Active = Entry.Button == TabButton
				Entry.Page.Visible = Active
				Tween(Entry.Button, { BackgroundTransparency = Active and 0 or 1 }, TWEEN_FAST)
				Tween(Entry.Lbl,    { TextColor3 = Active and T.Text or T.TextDark }, TWEEN_FAST)
				Tween(Entry.Marker, { Size = UDim2.fromOffset(2, Active and 18 or 0) }, TWEEN_BASE)
				if Entry.Icon then
					Tween(Entry.Icon, { ImageColor3 = Active and T.Text or T.TextDark }, TWEEN_FAST)
				end
			end
		end

		Connect(TabButton.MouseButton1Click, Select)
		Connect(TabButton.MouseEnter, function()
			if not Page.Visible then Tween(TabButton, { BackgroundTransparency = 0.6 }, TWEEN_FAST) end
		end)
		Connect(TabButton.MouseLeave, function()
			if not Page.Visible then Tween(TabButton, { BackgroundTransparency = 1 }, TWEEN_FAST) end
		end)

		if not FirstTab then FirstTab = true; Select() end

		-- ── Elemente ──────────────────────────────────────────────────
		-- Container ist austauschbar, damit AddSection dieselben Bauteile
		-- in einen eigenen Rahmen legen kann.
		local function BuildElements(Holder)
			local ElementFunction = {}

			-- Gemeinsame Grundform aller interaktiven Zeilen
			local function Row(Height)
				local Frame = New("Frame", {
					Parent = Holder,
					BackgroundColor3 = T.Second,
					Size = UDim2.new(1, 0, 0, Height or 40),
					ClipsDescendants = true,
				}, { Corner(7), Themed(Stroke(T.Stroke, 1, 0.4), "Stroke") })
				Themed(Frame, "Second")
				return Frame
			end

			local function Hoverable(Frame)
				Connect(Frame.MouseEnter, function() Tween(Frame, { BackgroundColor3 = T.Third }, TWEEN_FAST) end)
				Connect(Frame.MouseLeave, function() Tween(Frame, { BackgroundColor3 = T.Second }, TWEEN_FAST) end)
			end

			function ElementFunction:AddLabel(Text)
				local Frame = Row(34)
				local Lbl = New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = Text, Font = Enum.Font.Gotham, TextSize = 13,
					TextColor3 = T.Text,
					Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
					Size = UDim2.new(1, -24, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Left,
				})
				Themed(Lbl, "Text")
				local F = {}
				function F:Set(NewText) Lbl.Text = NewText end
				return F
			end

			function ElementFunction:AddParagraph(Text, Content)
				local Frame = New("Frame", {
					Parent = Holder,
					BackgroundColor3 = T.Second,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
				}, {
					Corner(7), Themed(Stroke(T.Stroke, 1, 0.4), "Stroke"),
					Padding(12, 12, 12, 12),
					New("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
				})
				Themed(Frame, "Second")

				Themed(New("TextLabel", {
					Parent = Frame, LayoutOrder = 1,
					BackgroundTransparency = 1,
					Text = Text, Font = Enum.Font.GothamBold, TextSize = 13,
					TextColor3 = T.Text,
					Size = UDim2.new(1, 0, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Left,
				}), "Text")

				local Body = New("TextLabel", {
					Parent = Frame, LayoutOrder = 2,
					BackgroundTransparency = 1,
					Text = Content or "", Font = Enum.Font.Gotham, TextSize = 12,
					TextColor3 = T.TextDark,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Left,
				})
				Themed(Body, "TextDark")

				local F = {}
				function F:Set(NewText) Body.Text = NewText end
				return F
			end

			function ElementFunction:AddButton(Cfg)
				Cfg = Cfg or {}
				Cfg.Name     = Cfg.Name     or "Button"
				Cfg.Callback = Cfg.Callback or function() end

				local Frame = Row(40)
				Hoverable(Frame)

				local Lbl = New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = Cfg.Name, Font = Enum.Font.GothamMedium, TextSize = 13,
					TextColor3 = T.Text,
					Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
					Size = UDim2.new(1, -40, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Left,
				})
				Themed(Lbl, "Text")

				-- Chevron statt Icon: zeigt an, dass hier etwas ausgeloest wird
				New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = "›", Font = Enum.Font.GothamBold, TextSize = 16,
					TextColor3 = T.TextDark,
					Position = UDim2.new(1, -14, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
					Size = UDim2.fromOffset(12, 16),
					TextXAlignment = Enum.TextXAlignment.Right,
				})

				local Click = New("TextButton", {
					Parent = Frame, BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 1), Text = "",
				})

				Connect(Click.MouseButton1Click, function()
					-- Kurzer Aufblitzer als Bestaetigung, kein Skalieren
					Tween(Frame, { BackgroundColor3 = T.Stroke }, TWEEN_FAST)
					task.wait(0.09)
					Tween(Frame, { BackgroundColor3 = T.Third }, TWEEN_FAST)
					pcall(Cfg.Callback)
				end)

				local F = {}
				function F:Set(NewText) Lbl.Text = NewText end
				return F
			end

			function ElementFunction:AddToggle(Cfg)
				Cfg = Cfg or {}
				Cfg.Name     = Cfg.Name     or "Toggle"
				Cfg.Default  = Cfg.Default  or false
				Cfg.Callback = Cfg.Callback or function() end
				Cfg.Color    = Cfg.Color    or T.Accent
				Cfg.Save     = Cfg.Save     or false

				local Toggle = { Value = Cfg.Default, Save = Cfg.Save, Type = "Toggle" }

				local Frame = Row(40)
				Hoverable(Frame)

				Themed(New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = Cfg.Name, Font = Enum.Font.GothamMedium, TextSize = 13,
					TextColor3 = T.Text,
					Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
					Size = UDim2.new(1, -70, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Left,
				}), "Text")

				local Track = New("Frame", {
					Parent = Frame,
					BackgroundColor3 = T.Stroke,
					Size = UDim2.fromOffset(40, 22),
					Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
				}, { Corner(11) })

				local Knob = New("Frame", {
					Parent = Track,
					BackgroundColor3 = T.TextDark,
					Size = UDim2.fromOffset(16, 16),
					Position = UDim2.new(0, 3, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
				}, { Corner(8) })

				local Click = New("TextButton", {
					Parent = Frame, BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 1), Text = "",
				})

				function Toggle:Set(Value)
					Toggle.Value = Value
					Tween(Track, { BackgroundColor3 = Value and Cfg.Color or T.Stroke })
					Tween(Knob, {
						Position         = Value and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
						AnchorPoint      = Value and Vector2.new(1, 0.5) or Vector2.new(0, 0.5),
						BackgroundColor3 = Value and T.Main or T.TextDark,
					})
					pcall(Cfg.Callback, Value)
					SaveConfig(BlackairLib.ConfigName)
				end

				Connect(Click.MouseButton1Click, function() Toggle:Set(not Toggle.Value) end)
				Toggle:Set(Cfg.Default)

				if Cfg.Flag then BlackairLib.Flags[Cfg.Flag] = Toggle end
				return Toggle
			end

			function ElementFunction:AddSlider(Cfg)
				Cfg = Cfg or {}
				Cfg.Name      = Cfg.Name      or "Slider"
				Cfg.Min       = Cfg.Min       or 0
				Cfg.Max       = Cfg.Max       or 100
				Cfg.Increment = Cfg.Increment or 1
				Cfg.Default   = Cfg.Default   or 50
				Cfg.Callback  = Cfg.Callback  or function() end
				Cfg.ValueName = Cfg.ValueName or ""
				Cfg.Color     = Cfg.Color     or T.Accent
				Cfg.Save      = Cfg.Save      or false

				local Slider = { Value = Cfg.Default, Save = Cfg.Save, Type = "Slider", Dragging = false }

				local Frame = Row(54)

				Themed(New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = Cfg.Name, Font = Enum.Font.GothamMedium, TextSize = 13,
					TextColor3 = T.Text,
					Position = UDim2.fromOffset(12, 11),
					Size = UDim2.new(1, -100, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Left,
				}), "Text")

				local ValueLbl = New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = tostring(Cfg.Default) .. Cfg.ValueName,
					Font = Enum.Font.GothamMedium, TextSize = 12,
					TextColor3 = T.TextDark,
					Position = UDim2.new(1, -12, 0, 11), AnchorPoint = Vector2.new(1, 0),
					Size = UDim2.fromOffset(80, 16),
					TextXAlignment = Enum.TextXAlignment.Right,
				})

				local Track = New("Frame", {
					Parent = Frame,
					BackgroundColor3 = T.Stroke,
					Size = UDim2.new(1, -24, 0, 4),
					Position = UDim2.fromOffset(12, 38),
				}, { Corner(2) })

				local Fill = New("Frame", {
					Parent = Track,
					BackgroundColor3 = Cfg.Color,
					Size = UDim2.fromScale(0, 1),
				}, { Corner(2) })

				local Knob = New("Frame", {
					Parent = Track,
					BackgroundColor3 = Cfg.Color,
					Size = UDim2.fromOffset(10, 10),
					Position = UDim2.new(0, 0, 0.5, 0),
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundTransparency = 1,
				}, { Corner(5) })

				-- Grosszuegige, unsichtbare Greifflaeche — 4px Balken sind
				-- auf dem Handy sonst nicht zu treffen.
				local Hit = New("TextButton", {
					Parent = Frame, BackgroundTransparency = 1, Text = "",
					Size = UDim2.new(1, -24, 0, 28),
					Position = UDim2.fromOffset(12, 26),
				})

				local function Apply(Value)
					Value = math.clamp(Round(Value, Cfg.Increment), Cfg.Min, Cfg.Max)
					Slider.Value = Value
					local Alpha = (Value - Cfg.Min) / (Cfg.Max - Cfg.Min)
					Tween(Fill, { Size = UDim2.fromScale(Alpha, 1) }, TWEEN_FAST)
					Tween(Knob, { Position = UDim2.new(Alpha, 0, 0.5, 0) }, TWEEN_FAST)
					ValueLbl.Text = tostring(Value) .. Cfg.ValueName
					pcall(Cfg.Callback, Value)
				end

				local function FromInput(X)
					local Alpha = math.clamp((X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
					Apply(Cfg.Min + (Cfg.Max - Cfg.Min) * Alpha)
				end

				Connect(Hit.InputBegan, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1
						or Input.UserInputType == Enum.UserInputType.Touch then
						Slider.Dragging = true
						Tween(Knob, { BackgroundTransparency = 0, Size = UDim2.fromOffset(12, 12) }, TWEEN_FAST)
						FromInput(Input.Position.X)
					end
				end)
				Connect(Hit.InputEnded, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1
						or Input.UserInputType == Enum.UserInputType.Touch then
						Slider.Dragging = false
						Tween(Knob, { BackgroundTransparency = 1, Size = UDim2.fromOffset(10, 10) }, TWEEN_FAST)
						SaveConfig(BlackairLib.ConfigName)
					end
				end)
				Connect(UserInputService.InputChanged, function(Input)
					if Slider.Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement
						or Input.UserInputType == Enum.UserInputType.Touch) then
						FromInput(Input.Position.X)
					end
				end)

				Connect(Frame.MouseEnter, function()
					Tween(Knob, { BackgroundTransparency = 0 }, TWEEN_FAST)
				end)
				Connect(Frame.MouseLeave, function()
					if not Slider.Dragging then Tween(Knob, { BackgroundTransparency = 1 }, TWEEN_FAST) end
				end)

				function Slider:Set(Value) Apply(Value) end
				Apply(Cfg.Default)

				if Cfg.Flag then BlackairLib.Flags[Cfg.Flag] = Slider end
				return Slider
			end

			-- Gemeinsamer Unterbau fuer Dropdown und MultiDropdown: beide
			-- klappen in der Liste auf, statt zu ueberlagern — das erspart
			-- ZIndex-Gefrickel und scrollt korrekt mit.
			local function BuildDropdown(Cfg, Multi)
				local ROW, MAXH = 40, 132
				local State = {
					Options  = Cfg.Options or {},
					Buttons  = {},
					Toggled  = false,
					Save     = Cfg.Save or false,
					Type     = Multi and "MultiDropdown" or "Dropdown",
				}
				State.Value = Multi and {} or (Cfg.Default or "")
				if Multi then
					for _, V in ipairs(Cfg.Default or {}) do State.Value[V] = true end
				end

				local Frame = New("Frame", {
					Parent = Holder,
					BackgroundColor3 = T.Second,
					Size = UDim2.new(1, 0, 0, ROW),
					ClipsDescendants = true,
				}, { Corner(7), Themed(Stroke(T.Stroke, 1, 0.4), "Stroke") })
				Themed(Frame, "Second")

				Themed(New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = Cfg.Name, Font = Enum.Font.GothamMedium, TextSize = 13,
					TextColor3 = T.Text,
					Position = UDim2.fromOffset(12, 12),
					Size = UDim2.new(0.5, -12, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Left,
				}), "Text")

				local Current = New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = "—", Font = Enum.Font.Gotham, TextSize = 12,
					TextColor3 = T.TextDark,
					Position = UDim2.new(1, -30, 0, 12), AnchorPoint = Vector2.new(1, 0),
					Size = UDim2.new(0.5, -30, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Right,
					TextTruncate = Enum.TextTruncate.AtEnd,
				})

				local Chevron = New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = "›", Font = Enum.Font.GothamBold, TextSize = 16,
					TextColor3 = T.TextDark,
					Position = UDim2.new(1, -12, 0, 12), AnchorPoint = Vector2.new(1, 0),
					Size = UDim2.fromOffset(12, 16),
					Rotation = 90,
				})

				local ListHolder = New("ScrollingFrame", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(8, ROW),
					Size = UDim2.new(1, -16, 0, MAXH - 8),
					BorderSizePixel = 0,
					CanvasSize = UDim2.new(),
					AutomaticCanvasSize = Enum.AutomaticSize.Y,
					ScrollBarThickness = 2,
					ScrollBarImageColor3 = T.Stroke,
				}, { New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }) })

				local Header = New("TextButton", {
					Parent = Frame, BackgroundTransparency = 1, Text = "",
					Size = UDim2.new(1, 0, 0, ROW),
				})

				local function Refresh()
					if Multi then
						local Picked = {}
						for Opt, On in pairs(State.Value) do if On then table.insert(Picked, Opt) end end
						table.sort(Picked)
						Current.Text = #Picked > 0 and table.concat(Picked, ", ") or "—"
					else
						Current.Text = (State.Value ~= "" and State.Value) or "—"
					end
				end

				local function StyleButton(Btn, Active)
					Tween(Btn, { BackgroundTransparency = Active and 0 or 1 }, TWEEN_FAST)
					Tween(Btn:FindFirstChildOfClass("TextLabel"),
						{ TextColor3 = Active and T.Text or T.TextDark }, TWEEN_FAST)
				end

				local function Rebuild()
					for _, B in pairs(State.Buttons) do B:Destroy() end
					State.Buttons = {}

					for _, Option in ipairs(State.Options) do
						local Btn = New("TextButton", {
							Parent = ListHolder,
							BackgroundColor3 = T.Third,
							BackgroundTransparency = 1,
							Size = UDim2.new(1, 0, 0, 30),
							Text = "", AutoButtonColor = false,
						}, { Corner(5) })

						New("TextLabel", {
							Parent = Btn,
							BackgroundTransparency = 1,
							Text = tostring(Option), Font = Enum.Font.Gotham, TextSize = 12,
							TextColor3 = T.TextDark,
							Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
							Size = UDim2.new(1, -20, 0, 16),
							TextXAlignment = Enum.TextXAlignment.Left,
						})

						Connect(Btn.MouseButton1Click, function()
							if Multi then
								State.Value[Option] = not State.Value[Option] or nil
								StyleButton(Btn, State.Value[Option] == true)
								Refresh()
								pcall(Cfg.Callback, State.Value)
							else
								State.Value = Option
								for Opt, B in pairs(State.Buttons) do StyleButton(B, Opt == Option) end
								Refresh()
								pcall(Cfg.Callback, Option)
							end
							SaveConfig(BlackairLib.ConfigName)
						end)

						State.Buttons[Option] = Btn
						local Active = Multi and State.Value[Option] == true or State.Value == Option
						StyleButton(Btn, Active)
					end
					Refresh()
				end

				Connect(Header.MouseButton1Click, function()
					State.Toggled = not State.Toggled
					Tween(Frame, { Size = UDim2.new(1, 0, 0, State.Toggled and (ROW + MAXH) or ROW) })
					Tween(Chevron, { Rotation = State.Toggled and 270 or 90 })
				end)

				Connect(Frame.MouseEnter, function()
					if not State.Toggled then Tween(Frame, { BackgroundColor3 = T.Third }, TWEEN_FAST) end
				end)
				Connect(Frame.MouseLeave, function()
					Tween(Frame, { BackgroundColor3 = T.Second }, TWEEN_FAST)
				end)

				function State:Refresh(Options, Delete)
					if Delete then
						State.Options = Options
						if Multi then State.Value = {} else State.Value = "" end
					else
						State.Options = Options
					end
					Rebuild()
				end

				if Multi then
					function State:Set(Value)
						State.Value = {}
						for _, V in ipairs(Value or {}) do State.Value[V] = true end
						for Opt, B in pairs(State.Buttons) do StyleButton(B, State.Value[Opt] == true) end
						Refresh()
						pcall(Cfg.Callback, State.Value)
					end
					function State:Toggle(Option)
						State.Value[Option] = not State.Value[Option] or nil
						if State.Buttons[Option] then
							StyleButton(State.Buttons[Option], State.Value[Option] == true)
						end
						Refresh()
						pcall(Cfg.Callback, State.Value)
					end
					function State:Get()
						local Out = {}
						for Opt, On in pairs(State.Value) do if On then table.insert(Out, Opt) end end
						return Out
					end
				else
					function State:Set(Value)
						State.Value = Value
						for Opt, B in pairs(State.Buttons) do StyleButton(B, Opt == Value) end
						Refresh()
						pcall(Cfg.Callback, Value)
					end
				end

				Rebuild()
				if Cfg.Flag then BlackairLib.Flags[Cfg.Flag] = State end
				return State
			end

			function ElementFunction:AddDropdown(Cfg)
				Cfg = Cfg or {}
				Cfg.Name     = Cfg.Name     or "Dropdown"
				Cfg.Options  = Cfg.Options  or {}
				Cfg.Default  = Cfg.Default  or ""
				Cfg.Callback = Cfg.Callback or function() end
				return BuildDropdown(Cfg, false)
			end

			function ElementFunction:AddMultiDropdown(Cfg)
				Cfg = Cfg or {}
				Cfg.Name     = Cfg.Name     or "Dropdown"
				Cfg.Options  = Cfg.Options  or {}
				Cfg.Default  = Cfg.Default  or {}
				Cfg.Callback = Cfg.Callback or function() end
				return BuildDropdown(Cfg, true)
			end

			function ElementFunction:AddBind(Cfg)
				Cfg = Cfg or {}
				Cfg.Name     = Cfg.Name     or "Bind"
				Cfg.Default  = Cfg.Default  or Enum.KeyCode.Unknown
				Cfg.Hold     = Cfg.Hold     or false
				Cfg.Callback = Cfg.Callback or function() end
				Cfg.Save     = Cfg.Save     or false

				local Bind = { Value = Cfg.Default, Binding = false, Type = "Bind", Save = Cfg.Save }

				local Frame = Row(40)
				Hoverable(Frame)

				Themed(New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = Cfg.Name, Font = Enum.Font.GothamMedium, TextSize = 13,
					TextColor3 = T.Text,
					Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
					Size = UDim2.new(1, -110, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Left,
				}), "Text")

				-- Taste als eigenes Chip-Element, damit klar ist, dass es klickbar ist
				local Chip = New("Frame", {
					Parent = Frame,
					BackgroundColor3 = T.Third,
					Size = UDim2.fromOffset(74, 26),
					Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
				}, { Corner(6), Stroke(T.Stroke, 1, 0.4) })

				local KeyLbl = New("TextLabel", {
					Parent = Chip,
					BackgroundTransparency = 1,
					Text = "—", Font = Enum.Font.GothamMedium, TextSize = 11,
					TextColor3 = T.TextDark,
					Size = UDim2.fromScale(1, 1),
					TextXAlignment = Enum.TextXAlignment.Center,
					TextTruncate = Enum.TextTruncate.AtEnd,
				})

				local Click = New("TextButton", {
					Parent = Frame, BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 1), Text = "",
				})

				local function Display(Key)
					if not Key or Key == Enum.KeyCode.Unknown then return "—" end
					return tostring(Key):gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", "")
				end

				function Bind:Set(Key)
					Bind.Value = Key
					KeyLbl.Text = Display(Key)
					SaveConfig(BlackairLib.ConfigName)
				end

				Connect(Click.MouseButton1Click, function()
					if Bind.Binding then return end
					Bind.Binding = true
					KeyLbl.Text = "..."
					Tween(Chip, { BackgroundColor3 = T.Stroke }, TWEEN_FAST)
				end)

				Connect(UserInputService.InputBegan, function(Input, Processed)
					if Bind.Binding then
						if Input.UserInputType == Enum.UserInputType.Keyboard then
							Bind.Binding = false
							Tween(Chip, { BackgroundColor3 = T.Third }, TWEEN_FAST)
							Bind:Set(Input.KeyCode)
						end
						return
					end
					if Processed then return end
					if Input.KeyCode == Bind.Value and Bind.Value ~= Enum.KeyCode.Unknown then
						pcall(Cfg.Callback)
					end
				end)

				Bind:Set(Cfg.Default)
				if Cfg.Flag then BlackairLib.Flags[Cfg.Flag] = Bind end
				return Bind
			end

			function ElementFunction:AddTextbox(Cfg)
				Cfg = Cfg or {}
				Cfg.Name          = Cfg.Name          or "Textbox"
				Cfg.Default       = Cfg.Default       or ""
				Cfg.TextDisappear = Cfg.TextDisappear or false
				Cfg.Callback      = Cfg.Callback      or function() end

				local Frame = Row(40)
				Hoverable(Frame)

				Themed(New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = Cfg.Name, Font = Enum.Font.GothamMedium, TextSize = 13,
					TextColor3 = T.Text,
					Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
					Size = UDim2.new(0.45, -12, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Left,
				}), "Text")

				local Field = New("Frame", {
					Parent = Frame,
					BackgroundColor3 = T.Third,
					Size = UDim2.new(0.5, -12, 0, 26),
					Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
				}, { Corner(6), Stroke(T.Stroke, 1, 0.4), Padding(0, 0, 8, 8) })

				local Box = New("TextBox", {
					Parent = Field,
					BackgroundTransparency = 1,
					Text = Cfg.Default,
					PlaceholderText = "...",
					Font = Enum.Font.Gotham, TextSize = 12,
					TextColor3 = T.Text,
					PlaceholderColor3 = T.TextDark,
					Size = UDim2.fromScale(1, 1),
					ClearTextOnFocus = false,
					TextXAlignment = Enum.TextXAlignment.Left,
				})

				Connect(Box.Focused, function()
					Tween(Field:FindFirstChildOfClass("UIStroke"), { Transparency = 0, Color = T.AccentDim }, TWEEN_FAST)
				end)
				Connect(Box.FocusLost, function()
					Tween(Field:FindFirstChildOfClass("UIStroke"), { Transparency = 0.4, Color = T.Stroke }, TWEEN_FAST)
					pcall(Cfg.Callback, Box.Text)
					if Cfg.TextDisappear then Box.Text = "" end
				end)

				local F = {}
				function F:Set(Value) Box.Text = Value end
				return F
			end

			function ElementFunction:AddColorpicker(Cfg)
				Cfg = Cfg or {}
				Cfg.Name     = Cfg.Name     or "Colorpicker"
				Cfg.Default  = Cfg.Default  or Color3.fromRGB(255, 255, 255)
				Cfg.Callback = Cfg.Callback or function() end
				Cfg.Save     = Cfg.Save     or false

				local ROW, PANEL = 40, 128
				local Picker = { Value = Cfg.Default, Toggled = false, Type = "Colorpicker", Save = Cfg.Save }
				local H, S, V = Color3.toHSV(Cfg.Default)

				local Frame = New("Frame", {
					Parent = Holder,
					BackgroundColor3 = T.Second,
					Size = UDim2.new(1, 0, 0, ROW),
					ClipsDescendants = true,
				}, { Corner(7), Themed(Stroke(T.Stroke, 1, 0.4), "Stroke") })
				Themed(Frame, "Second")

				Themed(New("TextLabel", {
					Parent = Frame,
					BackgroundTransparency = 1,
					Text = Cfg.Name, Font = Enum.Font.GothamMedium, TextSize = 13,
					TextColor3 = T.Text,
					Position = UDim2.fromOffset(12, 12),
					Size = UDim2.new(1, -60, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Left,
				}), "Text")

				local Swatch = New("Frame", {
					Parent = Frame,
					BackgroundColor3 = Cfg.Default,
					Size = UDim2.fromOffset(30, 20),
					Position = UDim2.new(1, -12, 0, 10), AnchorPoint = Vector2.new(1, 0),
				}, { Corner(5), Stroke(T.Stroke, 1, 0.3) })

				local Header = New("TextButton", {
					Parent = Frame, BackgroundTransparency = 1, Text = "",
					Size = UDim2.new(1, 0, 0, ROW),
				})

				-- Saettigung/Helligkeit als Flaeche, Farbton als Balken darunter
				local Field = New("ImageLabel", {
					Parent = Frame,
					Position = UDim2.fromOffset(12, ROW + 4),
					Size = UDim2.new(1, -24, 0, 84),
					BackgroundColor3 = Color3.fromHSV(H, 1, 1),
					Image = "rbxassetid://4155801252", -- Weiss->Transparent Verlauf
					BorderSizePixel = 0,
				}, { Corner(6) })

				local FieldDot = New("Frame", {
					Parent = Field,
					BackgroundColor3 = Color3.new(1, 1, 1),
					Size = UDim2.fromOffset(8, 8),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(S, 1 - V),
				}, { Corner(4), Stroke(Color3.new(0, 0, 0), 1, 0.5) })

				local HueBar = New("Frame", {
					Parent = Frame,
					Position = UDim2.fromOffset(12, ROW + 94),
					Size = UDim2.new(1, -24, 0, 12),
					BorderSizePixel = 0,
				}, {
					Corner(6),
					New("UIGradient", {
						Color = ColorSequence.new({
							ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
							ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
							ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
							ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
							ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
							ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
							ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
						})
					})
				})

				local HueDot = New("Frame", {
					Parent = HueBar,
					BackgroundColor3 = Color3.new(1, 1, 1),
					Size = UDim2.new(0, 4, 1, 4),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(H, 0, 0.5, 0),
				}, { Corner(2), Stroke(Color3.new(0, 0, 0), 1, 0.5) })

				local function Push()
					Picker.Value = Color3.fromHSV(H, S, V)
					Swatch.BackgroundColor3 = Picker.Value
					Field.BackgroundColor3  = Color3.fromHSV(H, 1, 1)
					FieldDot.Position       = UDim2.fromScale(S, 1 - V)
					HueDot.Position         = UDim2.new(H, 0, 0.5, 0)
					pcall(Cfg.Callback, Picker.Value)
				end

				local DragField, DragHue = false, false

				Connect(Field.InputBegan, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1
						or Input.UserInputType == Enum.UserInputType.Touch then DragField = true end
				end)
				Connect(Field.InputEnded, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1
						or Input.UserInputType == Enum.UserInputType.Touch then
						DragField = false; SaveConfig(BlackairLib.ConfigName)
					end
				end)
				Connect(HueBar.InputBegan, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1
						or Input.UserInputType == Enum.UserInputType.Touch then DragHue = true end
				end)
				Connect(HueBar.InputEnded, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1
						or Input.UserInputType == Enum.UserInputType.Touch then
						DragHue = false; SaveConfig(BlackairLib.ConfigName)
					end
				end)

				Connect(UserInputService.InputChanged, function(Input)
					if Input.UserInputType ~= Enum.UserInputType.MouseMovement
						and Input.UserInputType ~= Enum.UserInputType.Touch then return end
					if DragField then
						S = math.clamp((Input.Position.X - Field.AbsolutePosition.X) / Field.AbsoluteSize.X, 0, 1)
						V = 1 - math.clamp((Input.Position.Y - Field.AbsolutePosition.Y) / Field.AbsoluteSize.Y, 0, 1)
						Push()
					elseif DragHue then
						H = math.clamp((Input.Position.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X, 0, 1)
						Push()
					end
				end)

				Connect(Header.MouseButton1Click, function()
					Picker.Toggled = not Picker.Toggled
					Tween(Frame, { Size = UDim2.new(1, 0, 0, Picker.Toggled and (ROW + PANEL) or ROW) })
				end)

				function Picker:Set(Value)
					Picker.Value = Value
					H, S, V = Color3.toHSV(Value)
					Push()
				end

				Push()
				if Cfg.Flag then BlackairLib.Flags[Cfg.Flag] = Picker end
				return Picker
			end

			return ElementFunction
		end

		local TabElements = BuildElements(Page)

		-- Abschnitt: eigener Rahmen mit Ueberschrift, gleiche Bauteile darin
		function TabElements:AddSection(SectionConfig)
			SectionConfig = SectionConfig or {}
			SectionConfig.Name = SectionConfig.Name or "Section"

			local Wrapper = New("Frame", {
				Parent = Page,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
			}, { New("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }) })

			local Head = New("Frame", {
				Parent = Wrapper, LayoutOrder = 1,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 22),
			})

			Themed(New("TextLabel", {
				Parent = Head,
				BackgroundTransparency = 1,
				Text = string.upper(SectionConfig.Name),
				Font = Enum.Font.GothamBold, TextSize = 11,
				TextColor3 = T.TextDark,
				Position = UDim2.new(0, 2, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
				Size = UDim2.new(0, 200, 0, 14),
				TextXAlignment = Enum.TextXAlignment.Left,
			}), "TextDark")

			local Body = New("Frame", {
				Parent = Wrapper, LayoutOrder = 2,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
			}, { New("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }) })

			return BuildElements(Body)
		end

		return TabElements
	end

	return TabFunction
end

function BlackairLib:Destroy()
	for _, C in ipairs(self.Connections) do
		pcall(function() C:Disconnect() end)
	end
	self.Connections  = {}
	self.ThemeObjects = {}
	self.Flags        = {}
	pcall(function() Screen:Destroy() end)
end

-- Theme-Wechsel zur Laufzeit
function BlackairLib:SetTheme(Name)
	if self.Themes[Name] then
		self.SelectedTheme = Name
		ApplyTheme()
	end
end

return BlackairLib
