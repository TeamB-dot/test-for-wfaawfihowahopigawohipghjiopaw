	Config.ConfigFolder = Config.ConfigFolder or Config.Name
	Config.SaveConfig   = Config.SaveConfig   or false
	Config.HidePremium  = Config.HidePremium  or false
	if Config.IntroEnabled == nil then Config.IntroEnabled = true end
	Config.IntroText     = Config.IntroText     or "Loading..."
	Config.CloseCallback = Config.CloseCallback or function() end
	Config.ShowIcon      = Config.ShowIcon      or false
	Config.Icon          = Config.Icon          or "rbxassetid://112904952151156"

	local T = self.Themes[self.SelectedTheme]
	self.Folder     = Config.ConfigFolder
	self.SaveCfg    = Config.SaveConfig
	self.ConfigName = "config"

	if Config.SaveConfig and makefolder and isfolder then
		pcall(function()
			if not isfolder(Config.ConfigFolder) then makefolder(Config.ConfigFolder) end
		end)
	end

	local TabHolders, FirstTab, MinimizedState = {}, nil, false

	-- ── Rahmen ────────────────────────────────────────────────────────
