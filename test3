-- ─────────────────────────────────────────────────────────────────────
--  BEWEGUNG
--  Eine einzige Kurve fuer alles. Quart/Out laeuft schnell an und bremst
--  weich aus, ohne ueber das Ziel hinauszuschiessen — deshalb kein Back
--  oder Elastic, das laesst ein Menue billig wirken.
-- ─────────────────────────────────────────────────────────────────────
local SPEED      = 0.18
local EASE       = Enum.EasingStyle.Quart
local DIR        = Enum.EasingDirection.Out
local TWEEN_FAST = TweenInfo.new(0.12, EASE, DIR)
local TWEEN_BASE = TweenInfo.new(SPEED, EASE, DIR)
local TWEEN_SLOW = TweenInfo.new(0.28, EASE, DIR)

local function Tween(Object, Props, Info)
	local T = TweenService:Create(Object, Info or TWEEN_BASE, Props)
	T:Play()
	return T
end

-- ─────────────────────────────────────────────────────────────────────
--  BAU-HELFER
-- ─────────────────────────────────────────────────────────────────────
local function New(ClassName, Props, Children)
	local Object = Instance.new(ClassName)
	for Prop, Value in pairs(Props or {}) do
		if Prop ~= "Parent" then Object[Prop] = Value end
	end
	for _, Child in ipairs(Children or {}) do Child.Parent = Object end
	if Props and Props.Parent then Object.Parent = Props.Parent end
	return Object
end

local function Corner(Radius)
	return New("UICorner", { CornerRadius = UDim.new(0, Radius or 6) })
end

local function Stroke(Color, Thickness, Transparency)
	return New("UIStroke", {
		Color            = Color or BlackairLib.Themes.Default.Stroke,
		Thickness        = Thickness or 1,
		Transparency     = Transparency or 0,
		ApplyStrokeMode  = Enum.ApplyStrokeMode.Border,
	})
end

local function Padding(T, B, L, R)
	return New("UIPadding", {
		PaddingTop    = UDim.new(0, T or 0),
		PaddingBottom = UDim.new(0, B or T or 0),
		PaddingLeft   = UDim.new(0, L or 0),
		PaddingRight  = UDim.new(0, R or L or 0),
	})
end

local function List(Gap, Dir)
	return New("UIListLayout", {
		Padding          = UDim.new(0, Gap or 6),
		FillDirection    = Dir or Enum.FillDirection.Vertical,
		SortOrder        = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	})
end

local function Label(Text, Size, Font, Color)
	return New("TextLabel", {
		BackgroundTransparency = 1,
		Text        = Text or "",
		TextSize    = Size or 13,
		Font        = Font or Enum.Font.Gotham,
		TextColor3  = Color or BlackairLib.Themes.Default.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
end

-- Theme-Objekte werden registriert, damit ein Theme-Wechsel alles erfasst.
local function Themed(Object, Key)
	table.insert(BlackairLib.ThemeObjects, { Object = Object, Key = Key })
	return Object
end

local function ApplyTheme()
	local T = BlackairLib.Themes[BlackairLib.SelectedTheme]
	for _, Entry in ipairs(BlackairLib.ThemeObjects) do
		if Entry.Object and Entry.Object.Parent then
			local Prop = Entry.Object:IsA("UIStroke") and "Color"
				or (Entry.Object:IsA("TextLabel") or Entry.Object:IsA("TextBox")) and "TextColor3"
				or Entry.Object:IsA("ImageLabel") and "ImageColor3"
				or "BackgroundColor3"
			Entry.Object[Prop] = T[Entry.Key]
		end
	end
end

local function Connect(Signal, Fn)
	local C = Signal:Connect(Fn)
	table.insert(BlackairLib.Connections, C)
	return C
end

local function Round(Number, Factor)
	if Factor == 0 then return Number end
	local Result = math.floor(Number / Factor + (math.sign(Number) * 0.5)) * Factor
	return Result < 0 and Result + Factor or Result
end

-- Drag funktioniert mit Maus UND Touch; Position wird direkt gesetzt statt
-- getweent, sonst haengt das Fenster spuerbar hinter dem Finger zurueck.
local function Draggable(Handle, Frame)
	local Dragging, DragInput, MouseStart, StartPos

	Connect(Handle.InputBegan, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging   = true
			MouseStart = Input.Position
			StartPos   = Frame.Position
			Input.Changed:Connect(function()
				if Input.UserInputState == Enum.UserInputState.End then Dragging = false end
			end)
		end
	end)

	Connect(Handle.InputChanged, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then
			DragInput = Input
		end
	end)

	Connect(UserInputService.InputChanged, function(Input)
		if Input == DragInput and Dragging then
			local Delta = Input.Position - MouseStart
			Frame.Position = UDim2.new(
				StartPos.X.Scale, StartPos.X.Offset + Delta.X,
				StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y
			)
		end
	end)
end

-- ─────────────────────────────────────────────────────────────────────
--  KONFIG SPEICHERN
--  Format identisch zur alten Version, damit vorhandene Configs weiter
--  gelesen werden koennen.
-- ─────────────────────────────────────────────────────────────────────
local function PackColor(C) return { R = C.R * 255, G = C.G * 255, B = C.B * 255 } end
local function UnpackColor(C) return Color3.fromRGB(C.R, C.G, C.B) end

local function SaveConfig(Name)
	if not BlackairLib.SaveCfg or not writefile then return end
	local Data = {}
	for Flag, Value in pairs(BlackairLib.Flags) do
		if Value.Save then
			if Value.Type == "Colorpicker" then
				Data[Flag] = PackColor(Value.Value)
			elseif Value.Type == "Bind" then
				Data[Flag] = tostring(Value.Value)
			else
				Data[Flag] = Value.Value
			end
		end
	end
	pcall(function()
		writefile(BlackairLib.Folder .. "/" .. Name .. ".txt", HttpService:JSONEncode(Data))
	end)
end

local function LoadConfig(Config)
	local Ok, Data = pcall(function() return HttpService:JSONDecode(Config) end)
	if not Ok then return end
	for Flag, Value in pairs(Data) do
		local Element = BlackairLib.Flags[Flag]
		if Element then
			task.spawn(function()
				if Element.Type == "Colorpicker" then
					Element:Set(UnpackColor(Value))
				elseif Element.Type == "Bind" then
					-- Bind-Werte liegen als String vor ("Enum.KeyCode.E")
					local KeyName = tostring(Value):match("[^.]+$")
					if KeyName and Enum.KeyCode[KeyName] then Element:Set(Enum.KeyCode[KeyName]) end
				else
					Element:Set(Value)
				end
			end)
		end
	end
end

