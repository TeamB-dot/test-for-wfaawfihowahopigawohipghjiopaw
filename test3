function BlackairLib:MakeNotification(Config)
	Config = Config or {}
	Config.Name    = Config.Name    or "Notification"
	Config.Content = Config.Content or ""
	Config.Time    = Config.Time    or 5

	local T = self.Themes[self.SelectedTheme]

	-- Der Traeger wird vom UIListLayout positioniert; die Karte darin ist frei
	-- beweglich. Animiert wird nur X — eine Y-Bewegung wuerde die automatische
	-- Hoehe des Traegers mitziehen und den Stapel zappeln lassen.
	local Slot = New("Frame", {
		Parent                 = NotifyHolder,
		BackgroundTransparency = 1,
		Size                   = UDim2.new(1, 0, 0, 0),
		AutomaticSize          = Enum.AutomaticSize.Y,
	})

	local Card = New("Frame", {
		Parent           = Slot,
		BackgroundColor3 = T.Second,
		Size             = UDim2.new(1, 0, 0, 0),
		AutomaticSize    = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, {
		Corner(8),
		Stroke(T.Stroke, 1, 1),
		Padding(12, 12, 14, 14),
		New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Title = New("TextLabel", {
		Parent = Card, LayoutOrder = 1,
		BackgroundTransparency = 1,
		Size          = UDim2.new(1, 0, 0, 16),
		Text          = Config.Name,
		Font          = Enum.Font.GothamBold,
		TextSize      = 13,
		TextColor3    = T.Text,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local Body = New("TextLabel", {
		Parent = Card, LayoutOrder = 2,
		BackgroundTransparency = 1,
		Size          = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text          = Config.Content,
		Font          = Enum.Font.Gotham,
		TextSize      = 12,
		TextColor3    = T.TextDark,
		TextWrapped   = true,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	-- Duenner Fortschrittsbalken laeuft die Standzeit ab
	local Track = New("Frame", {
		Parent = Card, LayoutOrder = 3,
		BackgroundColor3 = T.Third,
		Size             = UDim2.new(1, 0, 0, 2),
		BackgroundTransparency = 1,
	}, { Corner(1) })

	local Fill = New("Frame", {
		Parent = Track,
		BackgroundColor3 = T.Accent,
		Size             = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, { Corner(1) })

	Card.Position = UDim2.new(0, 40, 0, 0)
	Tween(Card,  { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0 }, TWEEN_SLOW)
	Tween(Title, { TextTransparency = 0 }, TWEEN_SLOW)
	Tween(Body,  { TextTransparency = 0 }, TWEEN_SLOW)
	Tween(Track, { BackgroundTransparency = 0 }, TWEEN_SLOW)
	Tween(Fill,  { BackgroundTransparency = 0.4 }, TWEEN_SLOW)
	Tween(Card:FindFirstChildOfClass("UIStroke"), { Transparency = 0 }, TWEEN_SLOW)

	task.spawn(function()
		Tween(Fill, { Size = UDim2.fromScale(0, 1) }, TweenInfo.new(Config.Time, Enum.EasingStyle.Linear))
		task.wait(Config.Time)
		Tween(Card,  { Position = UDim2.new(0, 40, 0, 0), BackgroundTransparency = 1 })
		Tween(Title, { TextTransparency = 1 })
		Tween(Body,  { TextTransparency = 1 })
		Tween(Track, { BackgroundTransparency = 1 })
		Tween(Fill,  { BackgroundTransparency = 1 })
		task.wait(SPEED + 0.05)
		Slot:Destroy()
	end)
end

function BlackairLib:Init()
	if self.SaveCfg and isfile and readfile then
		local Path = self.Folder .. "/" .. (self.ConfigName or "config") .. ".txt"
		pcall(function()
			if isfile(Path) then
				LoadConfig(readfile(Path))
				self:MakeNotification({
					Name    = "Konfiguration",
					Content = "Gespeicherte Einstellungen geladen.",
					Time    = 4,
				})
			end
		end)
	end
	return self
end

