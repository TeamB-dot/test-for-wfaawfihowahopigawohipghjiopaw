		ClipsDescendants = true,
	}, { Corner(10), Themed(Stroke(T.Stroke), "Stroke") })
	Themed(Window, "Main")

	-- ── Kopfzeile ─────────────────────────────────────────────────────
	local TopBar = New("Frame", {
		Name = "TopBar", Parent = Window,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 48),
	})
	Draggable(TopBar, Window)

	local TitleX = 18
	if Config.ShowIcon then
		New("ImageLabel", {
			Parent = TopBar,
			BackgroundTransparency = 1,
			Image       = Config.Icon,
			Size        = UDim2.fromOffset(20, 20),
			Position    = UDim2.new(0, 18, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
		}, { Corner(4) })
		TitleX = 48
	end

	local TitleLabel = New("TextLabel", {
		Parent = TopBar,
		BackgroundTransparency = 1,
		Text        = Config.Name,
		Font        = Enum.Font.GothamBold,
		TextSize    = 14,
		TextColor3  = T.Text,
		Position    = UDim2.new(0, TitleX, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size        = UDim2.new(0, 300, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	Themed(TitleLabel, "Text")

	-- Fensterknöpfe: 32px Hitbox, damit sie auf dem Handy treffbar sind.
	local function TopButton(Text, Offset, Danger)
		local Btn = New("TextButton", {
			Parent = TopBar,
			BackgroundColor3 = T.Second,
			BackgroundTransparency = 1,
			Text        = Text,
			Font        = Enum.Font.GothamMedium,
			TextSize    = 14,
			TextColor3  = T.TextDark,
			Size        = UDim2.fromOffset(32, 32),
			Position    = UDim2.new(1, Offset, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			AutoButtonColor = false,
		}, { Corner(7) })

		Connect(Btn.MouseEnter, function()
			Tween(Btn, { BackgroundTransparency = 0 }, TWEEN_FAST)
			Tween(Btn, { TextColor3 = Danger and Color3.fromRGB(255, 90, 90) or T.Text }, TWEEN_FAST)
		end)
		Connect(Btn.MouseLeave, function()
			Tween(Btn, { BackgroundTransparency = 1 }, TWEEN_FAST)
			Tween(Btn, { TextColor3 = T.TextDark }, TWEEN_FAST)
		end)
		return Btn
	end

	local CloseBtn = TopButton("✕", -14, true)
	local MinBtn   = TopButton("—", -52, false)

	-- Haarlinie unter der Kopfzeile trennt sauberer als ein Farbwechsel
